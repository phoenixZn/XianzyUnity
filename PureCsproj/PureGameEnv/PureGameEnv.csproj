<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net5.0</TargetFramework>
    <RootNamespace>PureGameEnv</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>PureGameEnv</AssemblyName>
    <DefineConstants>XEASE_UNITY;CONSOLE_CLIENT;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Program.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)src\shim\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Assets\HotScripts\Framework\**\*.cs">
      <Link>Framework\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Assets\HotScripts\Product\**\*.cs">
      <Link>Product\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\Assets\HotScripts\Framework\**\*.Unity\**\*.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\Assets\HotScripts\Product\**\*.Unity\**\*.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\Assets\HotScripts\Framework\**\*.Unity.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\Assets\HotScripts\Product\**\*.Unity.cs" />
    <!-- Unity Editor 脚本：无 UnityEditor.dll，CLI 宿主不编入 -->
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\Assets\HotScripts\Framework\**\Editor\**\*.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\Assets\HotScripts\Product\**\Editor\**\*.cs" />
    <!-- UI 依赖 SvcUI.Unity 与 UnityEngine.UI，CLI 宿主不编入 -->
    <Compile Remove="$(MSBuildThisFileDirectory)..\..\Assets\HotScripts\Product\Content\UIScripts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Luban 运行时源码与生成代码同程序集；本机需已导入 com.code-philosophy.luban -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Library\PackageCache\com.code-philosophy.luban@*\Runtime\**\*.cs">
      <Link>Luban.Runtime\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(MSBuildThisFileDirectory)refs\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.SharedInternalsModule">
      <HintPath>$(MSBuildThisFileDirectory)refs\UnityEngine.SharedInternalsModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(MSBuildThisFileDirectory)refs\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MSBuildThisFileDirectory)..\..\Assets\Plugins\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\UniTask\UniTask.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\LitMotion\LitMotion.csproj" />
  </ItemGroup>
</Project>